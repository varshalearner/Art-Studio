# ============================================================
# Amber Easel Studio — environment variables
# Copy this file to .env.local and fill in the keys you have.
# EVERY key is optional: with no keys the app runs in DEMO MODE
# (localStorage data, mock login, mock payments).
# Each service switches to LIVE independently when its keys exist.
# ============================================================

# ---------- Site ----------
# Shown in the navbar, emails and metadata. Pick your studio name!
NEXT_PUBLIC_SITE_NAME="Amber Easel Studio"
# Full URL of the deployed site (used for SEO, sitemap, emails).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Default currency shown before the visitor picks one. Base prices are stored in INR.
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
# Platform commission taken from each sale (percent).
NEXT_PUBLIC_PLATFORM_COMMISSION_PERCENT=10
# Deposit a customer pays when accepting a commission quote (percent).
NEXT_PUBLIC_COMMISSION_DEPOSIT_PERCENT=40

# ---------- Supabase (auth + database + storage + realtime) ----------
# Create a free project at https://supabase.com → Project Settings → API.
# Then run supabase/schema.sql in the SQL editor (and optionally seed.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Payments (client-side keys) ----------
# Razorpay: https://dashboard.razorpay.com → Account & Settings → API Keys.
# Use TEST keys first (rzp_test_...), switch to live keys when ready.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# PayPal: https://developer.paypal.com → Apps & Credentials → Client ID.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ============================================================
# SERVER-ONLY SECRETS — never prefixed with NEXT_PUBLIC_.
# These are only read inside Next.js API routes / server code.
# ============================================================

# Supabase service role key (Project Settings → API → service_role).
# Used by server routes for webhooks and the /setup checker. KEEP SECRET.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay secret (shown once when you generate the key pair).
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret (Dashboard → Webhooks → create webhook → secret).
RAZORPAY_WEBHOOK_SECRET=

# PayPal secret (same page as the client ID).
PAYPAL_CLIENT_SECRET=

# Resend (transactional email): https://resend.com → API Keys.
RESEND_API_KEY=
# The "from" address for emails, e.g. "Amber Easel <hello@yourdomain.com>".
EMAIL_FROM=

# Exchange rates: free key from https://www.exchangerate-api.com (or leave
# empty to use the built-in approximate rates, refreshed manually).
EXCHANGE_RATE_API_KEY=
